modules = ["dotnet-7.0", "python-3.11", "nix"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build FlingerModMenu"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto-push to GitHub"

[[workflows.workflow]]
name = "Build FlingerModMenu"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "dotnet build FlingerModMenu.csproj -c Release"

[[workflows.workflow]]
name = "Auto-push to GitHub"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 watcher.py"
